---
import { SITE } from '@/config/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={SITE.name}>
      <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="var(--accent)" opacity=".15"/><path d="M18 44 L30 20 L38 36 L46 28" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{SITE.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {SITE.nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </div>
</header>

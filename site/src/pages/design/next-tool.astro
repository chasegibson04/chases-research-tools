---
// Internal preview of a candidate next tool (noindex, excluded from the sitemap via /design/).
import Base from '@/layouts/Base.astro';
import LadderPreview from '@/components/preview/LadderPreview';
---
<Base title="Preview: de novo residue ladders" description="Internal preview of a candidate tool" noindex>
  <div class="container-wide" style="padding-top:var(--space-6)">
    <h1 style="margin-bottom:var(--space-1)">Preview: de novo residue-ladder finder</h1>
    <p class="muted" style="margin-top:0">A working sketch of a possible next tool. It finds sequence tags in an MS/MS spectrum by linking peaks one residue mass apart (standard, non-standard and N-methyl residues). For cyclic peptides it shows how much mass the tag leaves unexplained.</p>
    <div class="tool-frame" style="padding:var(--space-4)">
      <LadderPreview client:only="preact" />
    </div>
  </div>
</Base>

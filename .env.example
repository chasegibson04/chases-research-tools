# Example environment file. The site needs no secrets to build or run.
# Copy to .env for local-only overrides; .env and .env.* are git-ignored (except this file).
# Public, non-secret IDs (AdSense client, Ko-fi username) live in site/src/config/monetization.ts.

# Machine-local roots (PC-wide rule: no absolute paths in code; read roots from here).
# Copy to .env and edit. A move of the project is a one-line change.
PROJECT_ROOT=
SCRATCH_ROOT=
DATA_ROOT=
BOX_ROOT=
# Optional: folder of public MS test files for corpus-backed tests (tests skip when unset).
MS_CORPUS=
